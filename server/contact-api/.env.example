# Copy to .env on the server (chmod 600) and fill in SMTP_PASS.
# .env is never committed: the root .gitignore excludes it.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=info@bi-services.ch
# A device password created for this purpose in Infomaniak
# (info@bi-services.ch -> Connected devices -> Add a device, e.g. "Website form").
SMTP_PASS=change-me
MAIL_FROM=info@bi-services.ch
MAIL_TO=info@bi-services.ch
# Websites allowed to post the form.
ALLOWED_ORIGINS=https://bi-services.ch,https://www.bi-services.ch,https://xn--biservices-srl-rgb.ch
